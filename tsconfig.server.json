{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["bun", "node", "vitest/globals"],
    "paths": {
      "@shared/*": ["./shared/*"]
    }
  },
  "include": [
    "server",
    "shared",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "scripts",
    "tests"
  ]
}
