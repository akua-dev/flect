---
import "../activation-shell.css";
// biome-ignore lint/correctness/noUnusedImports: Astro consumes framework component imports in the template below.
import FlectWorkspaceIsland from "../workspace-entry";
---

<!doctype html>
<html lang="en" data-flect-state="inactive">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#080808" />
    <meta
      name="description"
      content="Flect turns an ongoing conversation into a live, editable product."
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Flect</title>
  </head>
  <body>
    <div class="activation-shell" id="flect-static-shell">
      <header class="activation-shell__bar" data-tauri-drag-region>
      </header>
      <main class="activation-shell__main">
        <h1>Describe the app you want to make.</h1>
        <p>
          Start with the outcome you need. Flect turns it into a live interface
          that you can continue using and changing here.
        </p>
        <form class="activation-shell__composer" data-flect-starter>
          <label class="sr-only" for="flect-starter-prompt">Message Flect</label>
          <textarea
            data-flect-activate
            id="flect-starter-prompt"
            name="prompt"
            placeholder="For example: a calm project planner for this week"
            required
            rows="3"></textarea>
          <button data-flect-activate type="submit">Create with Flect</button>
          <div aria-label="Starter ideas" class="activation-shell__examples">
            <button
              data-flect-example="A calm project planner for this week"
              type="button"
            >
              A calm project planner for this week
            </button>
            <button
              data-flect-example="A simple place to track my reading"
              type="button"
            >
              A simple place to track my reading
            </button>
            <button
              data-flect-example="A clear view of today's deliveries"
              type="button"
            >
              A clear view of today's deliveries
            </button>
          </div>
          <p
            aria-live="polite"
            class="activation-shell__status"
            id="flect-activation-status"
          >
            Describe the outcome, not the implementation. You can refine it
            after the first result.
          </p>
        </form>
      </main>
    </div>
    <div id="root" hidden>
      <FlectWorkspaceIsland client:flect />
    </div>
    <noscript>Flect needs JavaScript only after you open the workspace.</noscript>
    <script>
      import { installFlectActivation } from "../activation/activate-flect";

      installFlectActivation();
    </script>
  </body>
</html>
