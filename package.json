{
	"name": "flect",
	"version": "0.2.0",
	"private": true,
	"packageManager": "bun@1.3.14",
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"prepare": "bun scripts/prepare-effect.ts",
		"dev": "bun scripts/dev.ts",
		"dev:server": "bun --watch server/index.ts",
		"dev:web": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1",
		"dev:stop": "ASTRO_TELEMETRY_DISABLED=1 astro dev stop",
		"dev:desktop": "bun run build:sidecar && tauri dev",
		"build": "bun run build:product && tsc -b && ASTRO_TELEMETRY_DISABLED=1 astro build && bun run check:bundle",
		"build:spa": "bun run build:product && tsc -b && vite build --outDir dist-spa",
		"build:product": "bun run --cwd packages/product build",
		"build:sidecar": "bun scripts/build-sidecar.ts",
		"build:desktop": "bun run build:sidecar && tauri build --config '{\"bundle\":{\"macOS\":{\"signingIdentity\":\"-\"}}}'",
		"build:desktop:inferred-signing": "bun run build:sidecar && tauri build",
		"build:desktop:public": "bun run build:sidecar && tauri build --config src-tauri/tauri.release.conf.json",
		"flect": "bun cli/flect.ts",
		"generate:flect-skill": "bun scripts/generate-flect-skill.ts",
		"check:flect-skill": "bun scripts/generate-flect-skill.ts --check",
		"check:quality": "bun scripts/product-quality-coverage.ts",
		"check:bundle": "bun scripts/check-browser-bundle.ts",
		"media:release": "bun scripts/capture-release-media.ts",
		"media:verify-reproducible": "FLECT_VERIFY_MEDIA_REPRODUCIBILITY=1 vitest run tests/media/release-media-repro.test.ts",
		"preview": "vite preview",
		"release:package": "bun scripts/package-release.ts",
		"release:verify": "vitest run scripts/package-release.test.ts scripts/release-update.test.ts scripts/native-update-fixture-dogfood.test.ts",
		"product:package": "bun scripts/package-product-sdk.ts",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:desktop:local": "bun scripts/verify-packaged-macos.ts",
		"test:pi-smoke": "bun scripts/smoke-pi.ts",
		"test:watch": "vitest",
		"typecheck": "tsc -b",
		"lint": "biome check . && oxfmt --check --ignore-path .oxfmtignore .",
		"format": "oxfmt --write --ignore-path .oxfmtignore .",
		"check:effect": "bun scripts/prepare-effect.ts --check",
		"check:effect-concurrency": "bun scripts/verify-effect-concurrency.ts",
		"check:rifty": "bun scripts/verify-rifty-dependencies.ts",
		"check": "bun run check:effect && bun run check:effect-concurrency && bun run check:rifty && bun run check:flect-skill && bun run check:quality && bun run lint && bun run typecheck && bun run test",
		"check:rust": "bun run build:sidecar && cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo test --manifest-path src-tauri/Cargo.toml",
		"check:all": "bun run check && bun run test:e2e && bun run check:rust && bun run build:desktop -- --bundles app"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "0.82.1",
		"@earendil-works/pi-coding-agent": "0.82.1",
		"@effect/platform-browser": "4.0.0-beta.102",
		"@effect/platform-bun": "4.0.0-beta.102",
		"@effect/platform-node": "4.0.0-beta.102",
		"@flect/product": "workspace:*",
		"@jitl/quickjs-ng-wasmfile-release-sync": "0.32.0",
		"@modelcontextprotocol/server": "2.0.0",
		"@radix-ui/react-use-controllable-state": "1.2.6",
		"@riftydev/npm-client": "0.2.0",
		"@riftydev/runtime-js": "0.2.0",
		"@riftydev/runtime-wasi": "0.2.0",
		"@riftydev/vfs": "0.2.0",
		"@rolldown/browser": "1.2.1",
		"@tauri-apps/api": "2.11.1",
		"@toon-format/toon": "4.1.0",
		"@types/semver": "7.7.1",
		"@vue/compiler-sfc": "3.5.41",
		"acorn": "8.18.0",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"effect": "4.0.0-beta.102",
		"esbuild-wasm": "0.28.1",
		"fflate": "0.8.3",
		"just-bash": "3.2.0",
		"lucide-react": "1.30.0",
		"preact": "10.29.8",
		"quickjs-emscripten-core": "0.32.0",
		"radix-ui": "1.6.7",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-markdown": "10.1.0",
		"rehype-raw": "7.0.0",
		"rehype-sanitize": "6.0.0",
		"remark-breaks": "4.0.0",
		"remark-gfm": "4.0.1",
		"scheduler": "0.27.0",
		"semver": "7.8.5",
		"shiki": "4.3.1",
		"svelte": "5.56.8",
		"typebox": "1.1.38",
		"use-stick-to-bottom": "1.1.6",
		"wasm-git": "0.0.17"
	},
	"devDependencies": {
		"@astrojs/preact": "6.0.2",
		"@axe-core/playwright": "4.12.1",
		"@biomejs/biome": "2.5.6",
		"@effect/vitest": "4.0.0-rc.109",
		"@modelcontextprotocol/client": "2.0.0",
		"@playwright/test": "1.62.1",
		"@tailwindcss/vite": "4.1.18",
		"@tauri-apps/cli": "2.11.4",
		"@testing-library/jest-dom": "7.0.0",
		"@testing-library/react": "16.3.2",
		"@testing-library/user-event": "14.6.1",
		"@types/bun": "1.3.14",
		"@types/node": "26.1.2",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "6.0.4",
		"astro": "7.2.0",
		"jsdom": "30.0.1",
		"oxfmt": "0.65.0",
		"shadcn": "4.16.2",
		"tailwindcss": "4.1.18",
		"typescript": "7.0.2",
		"vite": "8.1.5",
		"vitest": "4.1.10",
		"yaml": "2.9.0"
	}
}
