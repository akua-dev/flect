{
  "name": "flect",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "./scripts/prepare-effect.sh",
    "dev": "concurrently --kill-others --names runtime,shell \"bun run dev:server\" \"bun run dev:web\"",
    "dev:server": "bun --watch server/index.ts",
    "dev:web": "vite",
    "dev:desktop": "bun run build:sidecar && tauri dev",
    "build": "tsc -b && vite build",
    "build:sidecar": "bun scripts/build-sidecar.ts",
    "build:desktop": "bun run build:sidecar && tauri build",
    "media:release": "bun scripts/capture-release-media.ts",
    "media:verify-reproducible": "FLECT_VERIFY_MEDIA_REPRODUCIBILITY=1 vitest run tests/media/release-media-repro.test.ts",
    "preview": "vite preview",
    "release:package": "bun scripts/package-release.ts",
    "release:verify": "bunx vitest run scripts/package-release.test.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:pi-smoke": "bun scripts/smoke-pi.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check:effect": "./scripts/prepare-effect.sh --check",
    "check:rifty": "bun scripts/verify-rifty-dependencies.ts",
    "check": "bun run check:effect && bun run check:rifty && bun run lint && bun run typecheck && bun run test",
    "check:all": "bun run check && bun run test:e2e && cargo test --manifest-path src-tauri/Cargo.toml && bun run build:desktop -- --bundles app"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@effect/platform-browser": "4.0.0-beta.106",
    "@effect/platform-bun": "4.0.0-beta.106",
    "@jitl/quickjs-ng-wasmfile-release-sync": "0.32.0",
    "@riftydev/npm-client": "0.2.0",
    "@riftydev/runtime-js": "0.2.0",
    "@riftydev/runtime-wasi": "0.2.0",
    "@riftydev/vfs": "0.2.0",
    "@tauri-apps/api": "2.11.1",
    "acorn": "8.18.0",
    "effect": "4.0.0-beta.106",
    "esbuild-wasm": "0.28.1",
    "just-bash": "3.2.0",
    "quickjs-emscripten-core": "0.32.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typebox": "1.3.11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@effect/vitest": "4.0.0-beta.106",
    "@playwright/test": "1.62.1",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/bun": "1.3.14",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "10.0.4",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
