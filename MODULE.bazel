# Bazel module for the flect subtree.
#
# Boundary rule (cnap#866 "Bazel boundary rule for the published subtree"):
# files under apps/flect/ may reference only in-subtree targets, Bazel
# Central Registry (BCR) modules, and sha256-pinned direct downloads --
# never a cnap label. This module is therefore fully self-contained: it
# builds and tests standalone in the public projection with no dependency
# on anything outside this directory.
#
# Executor: flect is a bun-native project (see package.json
# "packageManager"), not pnpm, so aspect_rules_js (pnpm-only, see
# cnap#866 red-team review Front 2 / dukdog/rules_bun being hobby-grade)
# is deliberately not used. Instead this module downloads the pinned bun
# binary itself (sha256-pinned per platform below) and every check target
# is a thin, honest wrapper around the same "bun run <script>" commands a
# human would run locally -- see tools/bun/defs.bzl.
module(
    name = "flect",
    version = "0.2.0",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.0")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# Pinned bun 1.4.0 -- bumped from 1.3.14 (cnap#866 follow-up: real
# ubuntu-latest runs of the check_effect/check_rifty/etc. Bazel targets hit
# "Cannot find module '@effect/platform-bun/<Subpath>'" resolving a
# package's wildcard `exports` entry (`"./*": "./dist/*.js"`) under bun's
# native `bun run <file>.ts` execution -- Linux only, not reproducible on
# macOS, and not the same bare-specifier `require.resolve` that succeeds
# moments earlier in the same sandbox. 1.4.0 is the first release after
# 1.3.14 (2026-08-20 vs 2026-05-13) with real resolver/install/symlink
# changes in its ~250-commit diff; no changelog entry names this exact bug,
# so this bump is an empirical try, not a confirmed-matching fix -- see the
# PR body for whether it actually resolved the failure on a real run.
# This intentionally only repins the Bazel-downloaded binary here; the
# package.json "packageManager"/"@types/bun" pins and quality.yml's
# oven-sh/setup-bun version are bumped separately once/if this is confirmed
# to fix the failure, to keep this experiment's blast radius minimal.
# sha256 values verified directly against the GitHub release asset bytes
# (not just SHASUMS256.txt):
#   curl -sL <url> | shasum -a 256
BUN_VERSION = "1.4.0"

http_archive(
    name = "bun_linux_x64",
    build_file_content = """\
filegroup(
    name = "bun_bin",
    srcs = ["bun-linux-x64/bun"],
    visibility = ["//visibility:public"],
)
""",
    sha256 = "2d03fb5fb83ac8b567aca0a281b2ce1a1a19d488f56c2968d88c3f25e92fe452",
    url = "https://github.com/oven-sh/bun/releases/download/bun-v{v}/bun-linux-x64.zip".format(v = BUN_VERSION),
)

http_archive(
    name = "bun_linux_arm64",
    build_file_content = """\
filegroup(
    name = "bun_bin",
    srcs = ["bun-linux-aarch64/bun"],
    visibility = ["//visibility:public"],
)
""",
    sha256 = "4b1a332ee861983eb93bcfe6f770fff94e3e31b2c388bdaea3c8ed35e58eed0e",
    url = "https://github.com/oven-sh/bun/releases/download/bun-v{v}/bun-linux-aarch64.zip".format(v = BUN_VERSION),
)

http_archive(
    name = "bun_darwin_arm64",
    build_file_content = """\
filegroup(
    name = "bun_bin",
    srcs = ["bun-darwin-aarch64/bun"],
    visibility = ["//visibility:public"],
)
""",
    sha256 = "c669e97f6164e1c96e0701748db98dfa77492908cbd8394c7557134a735de381",
    url = "https://github.com/oven-sh/bun/releases/download/bun-v{v}/bun-darwin-aarch64.zip".format(v = BUN_VERSION),
)
