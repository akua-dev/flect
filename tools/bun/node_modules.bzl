"""A single cacheable action that runs `bun install --frozen-lockfile` and
exposes the resulting node_modules tree as a Bazel directory artifact.

A plain genrule cannot declare a directory output (Bazel now errors: "output
... is a directory but was not declared as such"), so this is a small custom
rule using ctx.actions.declare_directory instead -- the "repository rule or a
genrule producing a node_modules tree" the design calls for, just spelled the
way modern Bazel requires for a directory result.

Coarse keying, by design: the action's only declared inputs are the lockfile
and every package.json in the (single-workspace) tree, so Bazel skips the
whole install -- network fetch included -- whenever those are unchanged, and
otherwise re-downloads from bun's registry the same way `bun install` would
locally. See BUILD.bazel's :node_modules target for why this is the honest
tradeoff for a bun (not pnpm) project: no hermetic rules_js-style install
exists for bun (see MODULE.bazel's module docstring).
"""

def _bun_node_modules_impl(ctx):
    out = ctx.actions.declare_directory(ctx.label.name)
    bun = ctx.executable.bun
    ctx.actions.run_shell(
        outputs = [out],
        inputs = ctx.files.srcs,
        tools = [bun],
        arguments = [bun.path, out.path],
        # See tools/bun/defs.bzl's _bun_action_impl for why: Bazel's default
        # action environment strips PATH entirely, which breaks anything
        # `bun install`'s (non-hermetic by design) postinstall/lifecycle
        # scripts might shell out to via bare command name.
        use_default_shell_env = True,
        command = """
set -euo pipefail
BUN="$1"
OUT="$2"
export HOME="$(mktemp -d)"
# bun's frozen-lockfile check does not tolerate package.json/bun.lock being
# symlinks (Bazel's sandbox places declared srcs as symlinks into the real
# source tree) -- it spuriously reports "lockfile had changes". Materialize
# real copies of just those files before installing.
for f in package.json bun.lock packages/product/package.json; do
  cp -L "$f" "$f.material"
  mv "$f.material" "$f"
done
"$BUN" install --frozen-lockfile --ignore-scripts
# bun links the local "packages/*" workspace member as a symlink pointing
# outside node_modules (../../packages/product). A Bazel tree artifact must
# be self-contained -- a symlink escaping it is rejected as "dangling" the
# moment the artifact is validated -- so replace it with a real copy of the
# workspace member's published contents (package.json + dist + README, per
# its own "files" allowlist) instead of the raw symlink.
if [ -L node_modules/@flect/product ]; then
  cp -RL node_modules/@flect/product node_modules/@flect/product.real
  rm node_modules/@flect/product
  mv node_modules/@flect/product.real node_modules/@flect/product
fi
# declare_directory pre-creates $OUT as an empty directory, so a plain
# `mv node_modules "$OUT"` nests the whole tree one level too deep
# (bazel-out/.../bin/node_modules/node_modules/...) instead of replacing
# it. Remove the empty placeholder first so the rename lands directly.
rmdir "$OUT"
mv node_modules "$OUT"
""",
        execution_requirements = {
            "no-remote-exec": "1",
            "requires-network": "1",
        },
        progress_message = "bun install --frozen-lockfile (%{label})",
    )
    return [DefaultInfo(files = depset([out]))]

bun_node_modules = rule(
    implementation = _bun_node_modules_impl,
    attrs = {
        "bun": attr.label(
            allow_single_file = True,
            cfg = "exec",
            executable = True,
        ),
        "srcs": attr.label_list(allow_files = True),
    },
)
