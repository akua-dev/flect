.github/**
.vscode/**

# Vendored and generated agent skills (hash-locked via skills-lock.json)
.agents/skills/**

# Written-through installer artifact: must stay byte-identical to the
# OPENCODE_PLUGIN_SOURCE string in src/lib/agent-integration.ts
assets/agent-integrations/**

# Tsconfigs use jsonc with comments / trailing commas — leave as-is
**/tsconfig.json
**/tsconfig*.json
